# Copy to config/nightly.env and adjust for your host.
#
# This file is passed to illumos nightly(1).
# Keep host-specific absolute paths here; keep policy in config/policy.env.

export GATE="${HOME}/repos/illumos-gate/usr/src"
export CODEMGR_WS="${HOME}/repos/illumos-gate"
export CLOSED_IS_PRESENT=yes
export ON_CLOSED_BINS="${HOME}/repos/on-closed-bins"

export STAFFER=bifrost
export MAILTO=
export MAIL=""
export REF_PROTO_LIST=
export PARENT_WS=
export CLONE_WS=

export NIGHTLY_OPTIONS='-AnC'
export ATLOG="/var/tmp/bifrost-build/logs/nightly.log"
export LOGFILE="/var/tmp/bifrost-build/logs/nightly.log"

# Tune compilers/toolchain per host image as needed.
# export GNU_ROOT=/usr/gcc/13
